{
  "name": "@amautai/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --local --local-upstream localhost:8787 --assets ../web/public",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "preview": "wrangler dev --port 8788 --local --local-upstream localhost:8788"
  },
  "dependencies": {
    "@workos-inc/node": "^11.0.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.6",
    "@amautai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.151.0"
  }
}

{
  "name": "amautai",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm run check:architecture && turbo build",
    "dev": "turbo dev",
    "lint": "pnpm run check:architecture && turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "check": "pnpm run lint && pnpm run test:architecture && pnpm run typecheck && pnpm --filter @amautai/worker run test && pnpm --filter web run test && pnpm --filter @amautai/whatsapp-gateway run test && pnpm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
